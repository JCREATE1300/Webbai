{
  "name": "webbai",
  "productName": "webbai",
  "version": "1.0.0-alpha",
  "description": "webbai desktop \u2014 chat + in-window AI page assistant",
  "main": "main.cjs",
  "author": "webbai",
  "devDependencies": {
    "@electron/packager": "^20.0.2",
    "electron": "^43.1.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.1.8",
    "electron-log": "^5.1.4"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "license": "ISC",
  "build": {
    "appId": "app.webbai.desktop",
    "productName": "webbai",
    "directories": {
      "output": "release",
      "buildResources": "."
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "ollama.cjs",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "webbai-windows.exe",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "installerHeader": "installerHeader.bmp",
      "installerSidebar": "installerSidebar.bmp",
      "uninstallerSidebar": "uninstallerSidebar.bmp",
      "include": "installer.nsh",
      "shortcutName": "webbai",
      "uninstallDisplayName": "webbai"
    },
    "publish": {
      "provider": "github",
      "owner": "JCREATE1300",
      "repo": "webbai"
    },
    "extraResources": [
      {
        "from": "vendor/ollama",
        "to": "ollama",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}