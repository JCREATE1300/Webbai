{
  "name": "webbai",
  "productName": "webbai",
  "version": "1.1.0",
  "description": "webbai desktop — chat + in-window AI page assistant",
  "main": "main.cjs",
  "author": "webbai",
  "devDependencies": {
    "@electron/packager": "^20.0.2",
    "electron": "^43.1.0",
    "electron-builder": "^25.1.8"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "license": "ISC",
  "build": {
    "appId": "app.webbai.desktop",
    "productName": "webbai",
    "directories": {
      "output": "release",
      "buildResources": "."
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "webbai-setup-${version}.exe"
    }
  }
}
